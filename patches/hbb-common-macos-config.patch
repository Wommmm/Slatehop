+    /// A GUI startup reply from the same-user daemon can predate a password
+    /// change. Adopt it in memory without writing it back to their shared file.
+    #[cfg(target_os = "macos")]
+    pub fn adopt_daemon_snapshot(cfg: Config) -> bool {
+        let mut current = CONFIG.write().unwrap();
+        if *current == cfg {
+            return false;
+        }
+        let key_pair = cfg.key_pair.clone();
+        *current = cfg;
+        drop(current);
+        Self::invalidate_key_pair_cache_if_changed(&key_pair);
+        true
+    }
